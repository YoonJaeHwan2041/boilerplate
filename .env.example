# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋되지 않음)
#
# docker compose 는 .env 를 자동으로 읽는다.
# 앱(gradle bootRun)에 넘기려면 직접 export:
#   export $(grep -v '^#' .env | xargs) && ./gradlew bootRun

# ===== JWT =====
# HS256 서명 키 — 원문 문자열, 최소 32바이트(권장 64자 이상). Access / Refresh 는 서로 다른 키.
JWT_SECRET=change-this-dev-only-secret-please-override-0123456789abcdef
JWT_REFRESH_SECRET=change-this-dev-only-REFRESH-secret-please-override-0123456789
JWT_REFRESH_ROTATION=false

# ===== 쿠키 (Refresh Token) =====
# 로컬(http) / 프론트·백 같은 host → 아래 그대로.
# 완전히 다른 도메인 + HTTPS → COOKIE_SECURE=true, COOKIE_SAME_SITE=None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_PATH=/api/v1/auth

# ===== 서버 =====
SERVER_PORT=8080

# ===== PostgreSQL =====
# DB_NAME / DB_USERNAME / DB_PASSWORD / DB_PORT : docker-compose 가 컨테이너를 만들 때 사용
# DB_URL : 앱(Spring)이 접속할 때 사용 (앱을 컨테이너로 띄우면 localhost -> postgres 로 변경)
DB_NAME=boilerplate
DB_USERNAME=boilerplate
DB_PASSWORD=boilerplate
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/boilerplate
JPA_DDL_AUTO=update

# ===== AWS S3 =====
# 실제 AWS: access/secret key 채우고 endpoint 는 비워둠 (또는 IAM Role 이면 key 도 비워둠)
# LocalStack: key 는 아무 값, AWS_S3_ENDPOINT=http://localhost:4566, AWS_S3_PATH_STYLE=true
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=boilerplate-local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_PATH_STYLE=false

# ===== 파일 업로드 크기 (선택) =====
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB
